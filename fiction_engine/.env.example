# Fiction Engine — переменные окружения
# Скопируй этот файл в .env и заполни нужные значения

# Секретный ключ Flask (любая случайная строка, минимум 16 символов)
# Генерация: python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=замени-на-случайную-строку-минимум-16-символов

# API ключи можно задать здесь или через интерфейс (Настройки → API ключи)
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
